#!/bin/bash
# Set the password of an account (or add one, as a member), then sign
# everyone out: the token key is replaced, so all browsers log in again.
# Members normally register on the page with the invite code and change
# their own password there; an admin can also reset one there. This is the
# way back in when nobody can log in as an admin.
#
#   sudo ba-recard-set-password            # account "admin"
#   sudo ba-recard-set-password <account>
#
# The password is asked twice on a terminal, or read from the first line of
# stdin when piped in.
set -euo pipefail
account="${1:-admin}"
conf=/etc/ba-recard/postgrest.conf

if [ -t 0 ]; then
  read -rsp "New password for $account: " pw; echo
  read -rsp "Repeat it: " pw2; echo
  [ "$pw" = "$pw2" ] || { echo "The two passwords differ; nothing changed." >&2; exit 1; }
else
  IFS= read -r pw || true
fi
[ -n "$pw" ] || { echo "Empty password; nothing changed." >&2; exit 1; }
[ -f "$conf" ] || { echo "$conf not found: run install.sh first." >&2; exit 1; }

sql_quote() { printf "'%s'" "${1//\'/\'\'}"; }
secret=$(openssl rand -hex 32)

cd /
runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d ba_recard <<SQL
begin;
insert into private.accounts (username, password_hash)
  values ($(sql_quote "$account"), extensions.crypt($(sql_quote "$pw"), extensions.gen_salt('bf', 10)))
  on conflict (username) do update set password_hash = excluded.password_hash, updated_at = now();
update private.settings set value = '$secret' where key = 'jwt_secret';
commit;
SQL
sed -i "s|^jwt-secret = .*|jwt-secret = \"$secret\"|" "$conf"
systemctl restart ba-recard-api.service
echo "Password for '$account' set. Everyone has to log in again."
